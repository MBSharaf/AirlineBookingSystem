@model AirlineBookingSystem.Models.Hotel
<div class="container mt-4">
    <div class="row">
        <div class="col-md-6 mx-auto">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h4 class="mb-0">Add Hotel</h4>
                </div>

             
                <div class="card-body">
                    <form method="post" enctype="multipart/form-data">

                        <!-- Hotel Name -->
                        <div class="mb-3">
                            <label for="hotelName" class="form-label">
                                Hotel Name
                            </label>
                            <input type="text"
                                   id="hotelName"
                                   name="Name"
                                   class="form-control"
                                   placeholder="Enter hotel name">
                        </div>

                        <!-- City -->
                        <div class="mb-3">
                            <label for="city" class="form-label">
                                City
                            </label>
                            <input type="text"
                                   id="city"
                                   name="City"
                                   class="form-control"
                                   placeholder="Enter city">
                        </div>

                        <!-- Description -->
                        <div class="mb-3">
                            <label for="description" class="form-label">
                                Description
                            </label>
                            <textarea id="description"
                                      name="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Enter hotel description"></textarea>
                        </div>

                        <!-- Rate -->
                        <div class="mb-3">
                            <label for="rate" class="form-label">
                                Rate
                            </label>
                            <input type="number"
                                   id="rate"
                                   name="Rate"
                                   class="form-control"
                                   placeholder="Enter hotel rate"
                                   min="1"
                                   max="5"
                                   step="0.1">
                        </div>

                        <!-- Address -->
                        <div class="mb-3">
                            <label for="address" class="form-label">
                                Address
                            </label>
                            <input type="text"
                                   id="address"
                                   name="Address"
                                   class="form-control"
                                   placeholder="Enter hotel address">
                        </div>

                        <!-- Image -->
                        <div class="mb-4">
                            <label for="image" class="form-label">
                                Hotel Image
                            </label>
                            <input type="file"
                                   id="image"
                                   name="ImageFile"
                                   accept="image/*"
                                   class="form-control">
                            <div class="form-text">
                                Upload a JPG, JPEG, or PNG image.
                            </div>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex justify-content-between">
                            <a href="/Admin/Hotels" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i>
                                Back
                            </a>

                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-plus-lg"></i>
                                Create Hotel
                            </button>
                        </div>

                    </form>
                </div>
                


                       
                    
                </div>
            </div>
        </div>
    </div>
</div>

