
<div class="container mt-4">
    <div class="row">
        <div class="col-md-6 mx-auto">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h4 class="mb-0">Add Booking</h4>
                </div>

             
                <div class="card-body">
                    <form method="post" enctype="multipart/form-data">

                        <!-- Booking Name -->
                        <div class="mb-3">
                            <label for="bookingName" class="form-label">
                                Booking Date
                            </label>
                            <input type="datetime-local"
                                   id="bookingName"
                                   name="BookingDate"
                                   class="form-control"
                                   placeholder="Enter booking date">
                        </div>

                        <!-- Passenger -->
                        <div class="mb-3">
                            <label for="FullName" class="form-label">
                                Passenger
                            </label>
                            <input type="text"
                                   id="FullName"
                                   name="FullName"
                                   class="form-control"
                                   placeholder="Enter passenger name">
                        </div>

                        <!-- Number of Seats -->
                        <div class="mb-3">
                            <label for="numberOfSeats" class="form-label">
                                Number of Seats
                            </label>
                            <input type="number"
                                   id="numberOfSeats"
                                   name="NumberOfSeats"
                                   class="form-control"
                                   placeholder="Enter number of seats"
                                   min="1">
                        </div>

                   

                        <!-- Total Price -->
                        <div class="mb-3">
                            <label for="totalPrice" class="form-label">
                                Total Price
                            </label>
                            <input type="number"
                                   id="totalPrice"
                                   name="TotalPrice"
                                   class="form-control"
                                   placeholder="Enter total price"
                                   min="0"
                                   step="0.01">
                        </div>

                        <!--Is Confirmed -->
                        <div class="mb-3">
                            <label for="IsConfirmed" class="form-label">Status</label>
                            <select name="IsConfirmed" class="form-select">
                                <option value="True" selected>Confirmed</option>
                                <option value="False">Not Confirmed</option>
                            </select>
                         
                        </div>

                        <!--Flight Name -->
                        <div class="mb-3">
                            <label for="rate" class="form-label">
                                Flight Name
                            </label>
                            <input type="text"
                                   id="flightNumber"
                                   name="FlightNumber"
                                   class="form-control"
                                   placeholder="Enter flight name"
                                   min="1">
                        </div>

                        @* <!-- Address -->
                        <div class="mb-3">
                            <label for="address" class="form-label">
                                Address
                            </label>
                            <input type="text"
                                   id="address"
                                   name="Address"
                                   class="form-control"
                                   placeholder="Enter booking address">
                        </div>

                        <!-- Image -->
                        <div class="mb-4">
                            <label for="image" class="form-label">
                                Booking Image
                            </label>
                            <input type="file"
                                   id="image"
                                   name="ImageFile"
                                   accept="image/*"
                                   class="form-control">
                            <div class="form-text">
                                Upload a JPG, JPEG, or PNG image.
                            </div>
                        </div> *@

                        <!-- Buttons -->
                        <div class="d-flex justify-content-between">
                            <a href="/Admin/Bookings" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i>
                                Back
                            </a>

                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-plus-lg"></i>
                                Create Booking
                            </button>
                        </div>

                    </form>
                </div>
                


                       
                    
                </div>
            </div>
        </div>
    </div>
</div>

