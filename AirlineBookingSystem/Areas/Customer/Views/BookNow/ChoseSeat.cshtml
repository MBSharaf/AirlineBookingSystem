@using AirlineBookingSystem.ViewModels
@model SeatBookingVM

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

    body {
        background: #f5f7fb;
    }

    .seat-card {
        border-radius: 25px;
        overflow: hidden;
        box-shadow: 0 15px 40px rgba(0,0,0,.08);
        border: none;
    }

    .airplane {
        background: white;
        border-radius: 30px;
        padding: 40px;
        position: relative;
        max-width: 700px;
        margin: auto;
        box-shadow: 0 10px 30px rgba(0,0,0,.08);
    }

        .airplane::before {
            content: "";
            position: absolute;
            top: -25px;
            left: 50%;
            transform: translateX(-50%);
            width: 180px;
            height: 50px;
            background: #0d6efd;
            border-radius: 100px 100px 0 0;
        }


    .seat {
        width: 50px;
        height: 50px;
        background: #dee2e6;
        border-radius: 15px;
        cursor: pointer;
        transition: .3s;
        display: flex;
        justify-content: center;
        align-items: center;
        font-weight: bold;
        margin-bottom: 15px;
    }

        .seat:hover {
            transform: scale(1.08);
        }


        .seat.selected {
            background: #198754;
            color: white;
        }


        .seat.booked {
            background: #dc3545;
            color: white;
            cursor: not-allowed;
        }

        .seat.business {
            background: #ffc107;
        }

            .seat.business.selected {
                background: #198754;
            }

    .aisle {
        width: 60px;
    }

    .legend-box {
        width: 25px;
        height: 25px;
        border-radius: 8px;
    }

    .summary-card {
        border-radius: 20px;
    }

    .flight-header {
        background: linear-gradient(to right,#0d6efd,#0b5ed7);
        color: white;
        border-radius: 25px;
    }

</style>


<div class="container py-5">

    <!-- Flight Details -->

    <div class="card flight-header border-0 p-4 shadow mb-5">

        <div class="row">

            <div class="col-md-4 text-center">
                <h5>@Model.Airport.City</h5>
                <h2>@Model.Airport.Name</h2>
            </div>

            <div class="col-md-4 text-center">

                <i class="bi bi-airplane fs-1"></i>

                <h6>Flight</h6>
                <small>@Model.Ticket.SeatClass</small>

            </div>

            <div class="col-md-4 text-center">
                <h5>@Model.Flight.DepartureTime</h5>
                <h2>@Model.Airport.Code</h2>
            </div>

        </div>

    </div>


    <div class="row g-4">

        <!-- Seat Selection -->


        <div class="col-lg-7">

            <div class="card seat-card p-4">

                <h3 class="fw-bold text-center mb-4">

                    Select Your Seat

                </h3>

                <div class="airplane">

                    <!-- BUSINESS -->

                    <h6 class="text-center mb-4 text-warning">
                        Business Class
                    </h6>

                    <div class="d-flex justify-content-center align-items-center">

                        <div>

                            <div class="d-flex">

                                <div class="seat business">1A</div>
                                <div class="seat business booked">1B</div>

                            </div>

                        </div>

                        <div class="aisle"></div>

                        <div>

                            <div class="d-flex">

                                <div class="seat business">1C</div>
                                <div class="seat business">1D</div>

                            </div>

                        </div>

                    </div>



                    <hr class="my-4">


                    <h6 class="text-center mb-4">

                        Economy Class

                    </h6>


                    <!-- Row 1 -->


                    <div class="d-flex justify-content-center">

                        <div class="seat">2A</div>
                        <div class="seat">2B</div>

                        <div class="aisle"></div>

                        <div class="seat booked">2C</div>
                        <div class="seat">2D</div>

                    </div>


                    <!-- Row 2 -->

                    <div class="d-flex justify-content-center">

                        <div class="seat">3A</div>
                        <div class="seat">3B</div>

                        <div class="aisle"></div>

                        <div class="seat">3C</div>
                        <div class="seat booked">3D</div>

                    </div>


                    <!-- Row 3 -->

                    <div class="d-flex justify-content-center">

                        <div class="seat">4A</div>
                        <div class="seat">4B</div>

                        <div class="aisle"></div>

                        <div class="seat">4C</div>
                        <div class="seat">4D</div>

                    </div>


                    <!-- Row 4 -->

                    <div class="d-flex justify-content-center">

                        <div class="seat">5A</div>
                        <div class="seat">5B</div>

                        <div class="aisle"></div>

                        <div class="seat">5C</div>
                        <div class="seat">5D</div>

                    </div>

                </div>


                <!-- Legend -->


                <div class="d-flex justify-content-center gap-4 mt-5">

                    <div class="d-flex align-items-center gap-2">
                        <div class="legend-box bg-secondary"></div>
                        Available
                    </div>


                    <div class="d-flex align-items-center gap-2">
                        <div class="legend-box bg-success"></div>
                        Selected
                    </div>


                    <div class="d-flex align-items-center gap-2">
                        <div class="legend-box bg-danger"></div>
                        Reserved
                    </div>


                </div>

            </div>

        </div>



        <!-- Personal Information -->


        <div class="col-lg-5">

            <div class="card shadow border-0 rounded-5 p-4">

                <h3 class="fw-bold mb-4">

                    Passenger Information

                </h3>

                <form>


                    <div class="mb-3">

                        <label class="form-label">

                            Full Name

                        </label>

                        <input type="text"
                               class="form-control form-control-lg">

                    </div>



                    <div class="mb-3">

                        <label class="form-label">

                            Email Address

                        </label>

                        <input type="email"
                               class="form-control form-control-lg">

                    </div>



                    <div class="mb-3">

                        <label class="form-label">

                            Phone Number

                        </label>

                        <input type="text"
                               class="form-control form-control-lg">

                    </div>



                    <div class="mb-3">

                        <label class="form-label">

                            Passport Number

                        </label>

                        <input type="text"
                               class="form-control form-control-lg">

                    </div>



                    <div class="mb-3">

                        <label class="form-label">

                            Selected Seat

                        </label>

                        <input type="text"
                               id="selectedSeat"
                               class="form-control form-control-lg"
                               readonly>

                    </div>



                    <!-- Summary -->


                    <div class="card summary-card bg-light border-0 p-3 mb-4">

                        <h5>Booking Summary</h5>

                        <hr>

                        <p>

                            Hotel :
                            <strong>@Model.Hotel.Name</strong>

                        </p>

                        <p>

                            Flight :
                            <strong>@Model.Flight.FlightNumber</strong>

                        </p>

                        <p>

                            Seat :
                            <strong id="seatSummary">

                                Not Selected

                            </strong>

                        </p>

                        <p>

                            Price :
                            <strong>

                                @Model.Ticket.TicketPrice

                            </strong>

                        </p>

                    </div>



                    <button class="btn btn-primary w-100 btn-lg">

                        Confirm Booking

                    </button>


                </form>

            </div>

        </div>

    </div>

</div>




<script>

    const seats = document.querySelectorAll(".seat:not(.booked)");

    const selectedSeatInput =
        document.getElementById("selectedSeat");

    const seatSummary =
        document.getElementById("seatSummary");


    seats.forEach(seat => {

        seat.addEventListener("click", () => {

            seats.forEach(s => {

                s.classList.remove("selected");

            });

            seat.classList.add("selected");


            let seatNumber = seat.innerText;


            selectedSeatInput.value = seatNumber;

            seatSummary.innerText = seatNumber;

        });

    });


</script>