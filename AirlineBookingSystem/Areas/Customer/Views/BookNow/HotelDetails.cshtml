@using AirlineBookingSystem.ViewModels
@model HotelDetailsVM


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <title>Shop Item - Start Bootstrap Template</title>
    <!-- Favicon-->
    <link rel="icon" type="image/x-icon" href="assets/favicon.ico" />
    <!-- Bootstrap icons-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- Core theme CSS (includes Bootstrap)-->
    <link href="~/css/customer/style.css" rel="stylesheet">
</head>
<body>

    <!-- Hotel section-->
    <section class="container py-5">

        <div class="card border-0 shadow-lg rounded-5 overflow-hidden">

            <div class="row g-0">

                <!-- Hotel Image -->

                <div class="col-lg-5">

                    <img src="~/images/HotelImages/@Model.Hotel.Image"
                         class="img-fluid h-100 w-100 object-fit-cover"
                         style="min-height:500px;" />

                </div>


                <!-- Hotel Details -->

                <div class="col-lg-7 p-5">

                    <span class="badge bg-success mb-3 fs-6">
                        @Model.Hotel.City
                    </span>


                    <h1 class="fw-bold display-5">
                        @Model.Hotel.Name
                    </h1>


                    <div class="mb-3">

                        <i class="bi bi-star-fill text-warning"></i>
                        <i class="bi bi-star-fill text-warning"></i>
                        <i class="bi bi-star-fill text-warning"></i>
                        <i class="bi bi-star-fill text-warning"></i>
                        <i class="bi bi-star-half text-warning"></i>

                        <span class="ms-2 text-muted">
                            4.5 / 5 Rating
                        </span>

                    </div>


                    <h5 class="fw-bold">

                        <i class="bi bi-geo-alt-fill me-2 text-danger"></i>

                        @Model.Hotel.City

                    </h5>


                    <p class="text-muted">

                        @Model.Hotel.Address

                    </p>


                    <hr />


                    <h5 class="fw-bold mb-3">

                        About The Hotel

                    </h5>


                    <p class="text-muted">

                        @Model.Hotel.Description

                    </p>


                </div>

            </div>

        </div>

    </section>

    <!-- airport section-->
    <section class="container mb-5">

        <div class="card shadow-sm border-0 rounded-4 p-4">

            <h3 class="fw-bold mb-4">

                <i class="bi bi-airplane-fill me-2 text-primary"></i>

                Arrival Airport

            </h3>


            <div class="row">

                <div class="col-lg-4">

                    <h6 class="text-muted">

                        Airport Name

                    </h6>

                    <h5>

                        @Model.Airport.Name

                    </h5>

                </div>


                <div class="col-lg-4">

                    <h6 class="text-muted">

                        Airport Code

                    </h6>

                    <h5>

                        @Model.Airport.Code

                    </h5>

                </div>


                <div class="col-lg-4">

                    <h6 class="text-muted">

                        City

                    </h6>

                    <h5>

                        @Model.Airport.City

                    </h5>

                </div>

            </div>

        </div>

    </section>

    <!-- Flight section-->
    <section class="container mb-5">

        <h2 class="fw-bold mb-4">

            Available Flights

        </h2>


        <!-- Flight Card -->

        @foreach (var item in Model.Flights)
            {
            <div class="card border-0 shadow-sm rounded-4 mb-4">

                <div class="card-body p-4">

                    <div class="row align-items-center">


                        <!-- Flight Number -->

                        <div class="col-lg-2">

                            <h5 class="fw-bold">

                                @item.FlightNumber

                            </h5>

                            <small class="text-muted">

                                Flight Number

                            </small>

                        </div>


                        <!-- Departure -->

                        <div class="col-lg-2">

                            <h4>

                                @item.DepartureTime

                            </h4>

                            <small class="text-muted">

                                Departure

                            </small>

                        </div>


                        <!-- Plane Icon -->

                        <div class="col-lg-2 text-center">

                            <i class="bi bi-airplane fs-2 text-primary"></i>

                        </div>


                        <!-- Arrival -->

                        <div class="col-lg-2">

                            <h4>

                                @item.ArrivalTime

                            </h4>

                            <small class="text-muted">

                                Arrival

                            </small>

                        </div>


                        <!-- Seats -->

                        <div class="col-lg-2">

                            <h5>

                                @item.AvailableSeats Seats

                            </h5>

                            <small class="text-success">

                                Available

                            </small>

                        </div>


                        <!-- Select Flight -->

                        <div class="col-lg-2">

                            <div class="d-grid">

                                <a href="/Customer/BookNow/ChoseSeat/@item.Id" class="btn btn-success">

                                    Select Flight

                                </a>

                            </div>

                        </div>


                    </div>


                    <hr />


                    <div class="row">

                        <div class="col-lg-4">

                            <strong>Distance:</strong> @item.DistanceInKM KM

                        </div>


                        <div class="col-lg-4">

                            <strong>Price / KM:</strong> $@item.PricePerKM

                        </div>


                        <div class="col-lg-4">

                            <strong>Total Price:</strong> $@(item.DistanceInKM * item.AvailableSeats)

                        </div>

                    </div>


                </div>

            </div>
            }


        <!-- Another Flight Card Here -->


    </section>


    <!-- Bootstrap core JS-->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Core theme JS-->
    <script src="~/js/customer/scripts.js"></script>
</body>
</html>
