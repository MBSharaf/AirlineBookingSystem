@{
    ViewData["Title"] = "Blog";
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>TRAVELER - Free Travel Website Template</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="Free HTML Templates" name="keywords">
    <meta content="Free HTML Templates" name="description">

    <!-- Favicon -->
    <link href="~/images/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <!-- Bootstrap icons-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <!-- Customized Bootstrap Stylesheet -->
    <link href="~/css/customer/style.css" rel="stylesheet">
</head>


<!-- HERO SECTION -->
<!-- Carousel Start -->
<div class="container-fluid p-0">
    <div id="header-carousel" class="carousel slide" data-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img class="w-100" src="~/images/carousel-1.jpg" alt="Image">
                <div class="carousel-caption d-flex flex-column align-items-center justify-content-center">
                    <div class="p-3" style="max-width: 900px;">
                        <h4 class="text-white text-uppercase mb-md-3">Tours & Travel</h4>
                        <h1 class="display-3 text-white mb-md-4">Let's Discover The World Together</h1>
                        <a href="/Customer/BookNow/Index" class="btn btn-primary py-md-3 px-md-5 mt-2">Book Now</a>
                    </div>
                </div>
            </div>
            <div class="carousel-item">
                <img class="w-100" src="~/images/carousel-2.jpg" alt="Image">
                <div class="carousel-caption d-flex flex-column align-items-center justify-content-center">
                    <div class="p-3" style="max-width: 900px;">
                        <h4 class="text-white text-uppercase mb-md-3">Tours & Travel</h4>
                        <h1 class="display-3 text-white mb-md-4">Discover Amazing Places With Us</h1>
                        <a href="/Customer/BookNow/Index" class="btn btn-primary py-md-3 px-md-5 mt-2">Book Now</a>
                    </div>
                </div>
            </div>
        </div>
        <a class="carousel-control-prev" href="#header-carousel" data-slide="prev">
            <div class="btn btn-dark" style="width: 45px; height: 45px;">
                <span class="carousel-control-prev-icon mb-n2"></span>
            </div>
        </a>
        <a class="carousel-control-next" href="#header-carousel" data-slide="next">
            <div class="btn btn-dark" style="width: 45px; height: 45px;">
                <span class="carousel-control-next-icon mb-n2"></span>
            </div>
        </a>
    </div>
</div>
<!-- Carousel End -->
<!-- FEATURED BLOG -->

<section class="py-5">

    <div class="container">

        <div class="card border-0 shadow-lg rounded-5 overflow-hidden">

            <div class="row g-0">

                <div class="col-lg-6">

                    <img src="https://images.unsplash.com/photo-1539768942893-daf53e448371?w=1200"
                         class="img-fluid h-100 object-fit-cover"
                         alt="Egypt">

                </div>


                <div class="col-lg-6">

                    <div class="card-body p-5">

                        <span class="badge bg-warning text-dark mb-3">
                            Featured Article
                        </span>

                        <h2 class="fw-bold">
                            Top Places To Visit In Egypt In 2026
                        </h2>

                        <p class="text-muted mt-4">
                            Discover Egypt's most beautiful destinations including Cairo, Luxor,
                            Alexandria, and Sharm El Sheikh.
                        </p>

                        <a href="#" class="btn btn-dark mt-3">
                            Read More
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- BLOG POSTS -->

<section class="pb-5">

    <div class="container">

        <div class="row g-4">


            <!-- BLOG CARD 1 -->

            <div class="col-lg-4">

                <div class="card border-0 shadow h-100 rounded-4">

                    <img src="https://images.unsplash.com/photo-1578898886225-c7c894047899?w=1200"
                         class="card-img-top"
                         alt="Hotel">

                    <div class="card-body">

                        <span class="badge bg-primary mb-3">
                            Hotels
                        </span>

                        <h4>
                            Best Hotels In Cairo
                        </h4>

                        <p class="text-muted">
                            Find the perfect hotel for your stay in Egypt's capital city.
                        </p>

                    </div>

                    <div class="card-footer bg-white border-0">

                        <a href="#" class="btn btn-outline-dark w-100">
                            Read Article
                        </a>

                    </div>

                </div>

            </div>



            <!-- BLOG CARD 2 -->

            <div class="col-lg-4">

                <div class="card border-0 shadow h-100 rounded-4">

                    <img src="https://images.unsplash.com/photo-1527631746610-bca00a040d60?w=1200"
                         class="card-img-top"
                         alt="Airport">

                    <div class="card-body">

                        <span class="badge bg-danger mb-3">
                            Airport Transfer
                        </span>

                        <h4>
                            Airport Transfer Tips
                        </h4>

                        <p class="text-muted">
                            Everything you need to know before arriving in Egypt.
                        </p>

                    </div>

                    <div class="card-footer bg-white border-0">

                        <a href="#" class="btn btn-outline-dark w-100">
                            Read Article
                        </a>

                    </div>

                </div>

            </div>



            <!-- BLOG CARD 3 -->

            <div class="col-lg-4">

                <div class="card border-0 shadow h-100 rounded-4">

                    <img src="https://images.unsplash.com/photo-1548013146-72479768bada?w=1200"
                         class="card-img-top"
                         alt="Luxor">

                    <div class="card-body">

                        <span class="badge bg-success mb-3">
                            Travel Guide
                        </span>

                        <h4>
                            A Weekend In Luxor
                        </h4>

                        <p class="text-muted">
                            Explore the ancient wonders of Luxor and make the most of your trip.
                        </p>

                    </div>

                    <div class="card-footer bg-white border-0">

                        <a href="#" class="btn btn-outline-dark w-100">
                            Read Article
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- WHY FOLLOW OUR BLOG -->

<section class="bg-light py-5">

    <div class="container text-center">

        <h2 class="fw-bold">
            Why Follow Our Blog?
        </h2>

        <div class="row mt-5 g-4">

            <div class="col-md-4">

                <i class="bi bi-airplane-engines-fill display-4 text-danger"></i>

                <h5 class="mt-3">
                    Travel Tips
                </h5>

                <p class="text-muted">
                    Helpful advice for tourists visiting Egypt.
                </p>

            </div>


            <div class="col-md-4">

                <i class="bi bi-buildings-fill display-4 text-primary"></i>

                <h5 class="mt-3">
                    Hotel Recommendations
                </h5>

                <p class="text-muted">
                    Discover the best hotels and accommodations.
                </p>

            </div>


            <div class="col-md-4">

                <i class="bi bi-geo-alt-fill display-4 text-success"></i>

                <h5 class="mt-3">
                    Destination Guides
                </h5>

                <p class="text-muted">
                    Explore Egypt's most amazing cities and attractions.
                </p>

            </div>

        </div>

    </div>

</section>



<!-- CALL TO ACTION -->

<section class="bg-warning py-5">

    <div class="container text-center">

        <h2 class="fw-bold">
            Start Your Journey Today
        </h2>

        <p class="lead mt-3">
            Book your hotel and airport transfer with confidence.
        </p>

        <a href="/Home/Contact"
           class="btn btn-dark btn-lg mt-3 px-5">
            Contact Us
        </a>

    </div>

</section>