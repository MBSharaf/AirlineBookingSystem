@model IEnumerable<Hotel>

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>TRAVELER - Free Travel Website Template</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="Free HTML Templates" name="keywords">
    <meta content="Free HTML Templates" name="description">

    <!-- Favicon -->
    <link href="~/images/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <!-- Bootstrap icons-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <!-- Customized Bootstrap Stylesheet -->
    <link href="~/css/customer/style.css" rel="stylesheet">
</head>


<!-- Carousel Start -->
<div class="container-fluid p-0">
    <div id="header-carousel" class="carousel slide" data-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img class="w-100" src="~/images/carousel-1.jpg" alt="Image">
                <div class="carousel-caption d-flex flex-column align-items-center justify-content-center">
                    <div class="p-3" style="max-width: 900px;">
                        <h4 class="text-white text-uppercase mb-md-3">Tours & Travel</h4>
                        <h1 class="display-3 text-white mb-md-4">Let's Discover The World Together</h1>
                        <a href="/Customer/BookNow/Index" class="btn btn-primary py-md-3 px-md-5 mt-2">Book Now</a>
                    </div>
                </div>
            </div>
            <div class="carousel-item">
                <img class="w-100" src="~/images/carousel-2.jpg" alt="Image">
                <div class="carousel-caption d-flex flex-column align-items-center justify-content-center">
                    <div class="p-3" style="max-width: 900px;">
                        <h4 class="text-white text-uppercase mb-md-3">Tours & Travel</h4>
                        <h1 class="display-3 text-white mb-md-4">Discover Amazing Places With Us</h1>
                        <a href="/Customer/BookNow/Index" class="btn btn-primary py-md-3 px-md-5 mt-2">Book Now</a>
                    </div>
                </div>
            </div>
        </div>
        <a class="carousel-control-prev" href="#header-carousel" data-slide="prev">
            <div class="btn btn-dark" style="width: 45px; height: 45px;">
                <span class="carousel-control-prev-icon mb-n2"></span>
            </div>
        </a>
        <a class="carousel-control-next" href="#header-carousel" data-slide="next">
            <div class="btn btn-dark" style="width: 45px; height: 45px;">
                <span class="carousel-control-next-icon mb-n2"></span>
            </div>
        </a>
    </div>
</div>
<!-- Carousel End --


<!-- ABOUT COMPANY -->

<section class="py-5">

    <div class="container">

        <div class="text-center mb-5">

            <h2 class="fw-bold">
                About Our Company
            </h2>

            <p class="text-muted">
                Delivering premium travel experiences throughout Egypt.
            </p>

        </div>


        <div class="row">

            <div class="col-lg-10 mx-auto text-center">

                <p class="fs-5 text-muted">

                    We are a local Egyptian travel company dedicated to helping tourists and business travelers enjoy a smooth and comfortable stay in Egypt.

                    Our services are designed to save your time and provide peace of mind from the moment you land at the airport until the end of your journey.

                </p>

            </div>

        </div>

    </div>

</section>



<!-- SERVICES -->

<section class="bg-light py-5">

    <div class="container">

        <div class="text-center mb-5">

            <h2 class="fw-bold">
                Our Services
            </h2>

        </div>

        <div class="row g-4">

            <div class="col-md-4">

                <div class="card shadow border-0 rounded-4 h-100">

                    <div class="card-body text-center p-4">

                        <i class="bi bi-house-door-fill display-3 text-danger"></i>

                        <h4 class="mt-4">
                            Hotel Reservations
                        </h4>

                        <p class="text-muted">
                            Choose from a wide range of hotels across Egypt with competitive prices and flexible booking options.
                        </p>

                    </div>

                </div>

            </div>


            <div class="col-md-4">

                <div class="card shadow border-0 rounded-4 h-100">

                    <div class="card-body text-center p-4">

                        <i class="bi bi-airplane  display-3 text-success"></i>

                        <h4 class="mt-4">
                            Enjoy convenient
                        </h4>

                        <p class="text-muted">
                            transportation between airports and your hotel with professional drivers.
                            Airport Transfers.
                        </p>

                    </div>

                </div>

            </div>



            <div class="col-md-4">

                <div class="card shadow border-0 rounded-4 h-100">

                    <div class="card-body text-center p-4">

                        <i class="bi bi-geo-alt-fill display-3 text-success"></i>

                        <h4 class="mt-4">
                            Travel Assistance
                        </h4>

                        <p class="text-muted">
                            Get recommendations for destinations, local attractions, and travel arrangements.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- WHY CHOOSE US -->

<section class="py-5">

    <div class="container">

        <div class="row align-items-center g-5">


            <div class="col-lg-6">

                <img src="https://images.unsplash.com/photo-1539650116574-8efeb43e2750?w=1200"
                     class="img-fluid rounded-5 shadow"
                     alt="Travel Services">

            </div>


            <div class="col-lg-6">

                <h2 class="fw-bold mb-4">
                    Why Choose Us?
                </h2>

                <ul class="list-group list-group-flush">

                    <li class="list-group-item">
                        ✔ Easy Online Reservations
                    </li>

                    <li class="list-group-item">
                        ✔ Affordable Prices
                    </li>

                    <li class="list-group-item">
                        ✔ Reliable Airport Pickup Service
                    </li>

                    <li class="list-group-item">
                        ✔ Professional Customer Support
                    </li>

                    <li class="list-group-item">
                        ✔ Trusted Local Travel Experts
                    </li>

                    <li class="list-group-item">
                        ✔ Safe And Comfortable Trips
                    </li>

                </ul>

            </div>

        </div>

    </div>

</section>



<!-- DESTINATIONS -->

<section class="bg-light py-5 d-flex">

    <div class="container">

        <div class="text-center mb-5">

            <h2 class="fw-bold">
                Popular Destinations
            </h2>

            <p class="text-muted">
                Discover Egypt's most beautiful cities.
            </p>

        </div>


        @foreach(var item in Model)
        {
            <!-- Hotel section-->
            <section class="container py-5 d-flex">

                <div class="card border-0 shadow-lg rounded-5 overflow-hidden d-flex">

                    <div class="row g-0">

                        <!-- Hotel Image -->

                        <div class="col-lg-5">

                            <img src="~/images/@item.Image"
                                 class="img-fluid h-100 w-100 object-fit-cover"
                                 style="min-height:500px;" />

                        </div>


                        <!-- Hotel Details -->

                        <div class="col-lg-7 p-5">

                            <span class="badge bg-success mb-3 fs-6">
                                @item.City
                            </span>


                            <h1 class="fw-bold display-5">
                                @item.Name
                            </h1>


                            <!-- Rating -->

                            <div class="mb-3">

                                @for (var i = 0; i < Math.Round(item.Rate); i++)
                                {
                                    <i class="bi bi-star-fill text-warning"></i>
                                }

                                @for (var i = 0; i < 5 - Math.Round(item.Rate); i++)
                                {
                                    <i class="bi bi-star text-warning"></i>
                                }

                                <span class="ms-2 text-muted">

                                    (@item.Rate)

                                </span>

                            </div>




                            <h5 class="fw-bold">

                                <i class="bi bi-geo-alt-fill me-2 text-danger"></i>

                                @item.City

                            </h5>


                            <p class="text-muted">

                                @item.Address

                            </p>


                            <hr />


                            <h5 class="fw-bold mb-3">

                                About The Hotel

                            </h5>


                            <p class="text-muted">

                                @item.Description

                            </p>

                             <!-- Product actions-->
                            <div class="card-footer p-4 pt-0 border-top-0 bg-transparent">
                                <div class="text-center"><a class="btn btn-success mt-auto" href="/Customer/BookNow/HotelDetails/@item.Id">Show Details</a></div>
                            </div>

                        </div>



                    </div>



                </div>

            </section>
        }

    </div>

</section>



<!-- MISSION -->

<section class="py-5">

    <div class="container text-center">

        <h2 class="fw-bold mb-4">
            Our Mission
        </h2>

        <p class="fs-5 text-muted mx-auto" style="max-width:800px;">

            Our mission is to provide travelers with an easy, secure, and enjoyable experience when visiting Egypt by offering high-quality hotel reservations and airport transportation services.

        </p>

    </div>

</section>



<!-- CALL TO ACTION -->

<section class="bg-warning py-5">

    <div class="container text-center">

        <h2 class="fw-bold">
            Start Your Egyptian Adventure Today
        </h2>

        <p class="lead mt-3">
            Book your hotel and airport transfer in just a few clicks.
        </p>

        <a href="/Home/Contact"
           class="btn btn-dark btn-lg px-5 mt-3">
            Contact Us
        </a>

    </div>

</section>